            ]
          },
          {
            "stage": "verify",
            "effects": [
              "change"
            ]
          }
        ]
      }
    },
    {
      "path": "drawing export",
      "type": "write",
      "description": "Export a PNG preview of an SVG drawing to a new file under an authorized output root.",
      "params": [
        {
          "name": "file",
          "type": "path",
          "required": true,
          "multiple": false
        },
        {
          "name": "output",
          "type": "path",
          "required": true,
          "multiple": false,
          "description": "a new PNG path under an output root"
        },
        {
          "name": "dpi",
          "type": "integer",
          "required": false,
          "multiple": false,
          "default": 96
        }
      ],
      "output_schema": "receipt",
      "examples": [
        "sample-driver drawing export --file D:/work/copy/part-01.svg --output D:/work/out/part-01.png --dry-run",
        "sample-driver drawing export --file D:/work/copy/part-01.svg --output D:/work/out/part-01.png --confirm <confirm_token>"
      ],
      "driver": {
