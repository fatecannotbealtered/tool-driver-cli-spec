  "schemas": {
    "urn:sample-driver:context-data:1.0": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:sample-driver:context-data:1.0",
      "type": "object",
      "properties": {
        "product": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        },
        "profile": { "enum": ["file", "session", "device"] },
        "ready": { "const": false },
        "native": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "unsupported",
              "unconfigured",
              "not_connected"
              ]
            },
            "application_version": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "application_version",
            "reason"
          ],
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "not_run"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "native",
        "limitations"
      ],
      "additionalProperties": false
    },
    "urn:sample-driver:empty-request:1.0": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:sample-driver:empty-request:1.0",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "urn:sample-driver:inspect-request:1.0": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:sample-driver:inspect-request:1.0",
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "urn:sample-driver:inspect-data:1.0": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:sample-driver:inspect-data:1.0",
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "target",
        "observations"
      ],
      "additionalProperties": false
    },
    "urn:sample-driver:context-result:1.0": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:sample-driver:context-result:1.0",
      "type": "object",
      "allOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:response:1.0"
        },
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "urn:sample-driver:context-data:1.0"
              }
            }
          }
        }
      ]
    },
    "urn:sample-driver:inspect-result:1.0": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:sample-driver:inspect-result:1.0",
      "type": "object",
      "allOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:response:1.0"
        },
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "urn:sample-driver:inspect-data:1.0"
              }
            }
          }
        }
      ]
    }
  },
