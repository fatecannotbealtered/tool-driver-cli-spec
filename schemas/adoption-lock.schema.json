{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:adoption-lock:1.0",
  "title": "adoption-lock",
  "type": "object",
  "properties": {
    "spec_version": {
      "allOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/semver"
        },
        {
          "pattern": "^1\\."
        }
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "source_path": {
            "type": "string",
            "pattern": "^schemas/[A-Za-z0-9][A-Za-z0-9._-]*\\.schema\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "source_path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "spec_version",
    "schema_version",
    "source_commit",
    "package_sha256",
    "files"
  ],
  "additionalProperties": false
}
