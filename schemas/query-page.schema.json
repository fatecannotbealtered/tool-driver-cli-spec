{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:query-page:1.0",
  "title": "query-page",
  "description": "可选集合读取 profile。正常分页与无法完整读取分开；弱一致性不能冒充固定快照。",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "spec_version": {
      "allOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/semver"
        },
        {
          "pattern": "^1\\."
        }
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/target"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "object"
        }
      },
      "required": [
        "targets",
        "description",
        "selector"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/snapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_unavailable_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "consistency": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "snapshot",
            "live",
            "best_effort"
          ]
        },
        "drift_policy": {
          "enum": [
            "reject",
            "report"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "mode",
        "drift_policy",
        "limitations"
      ],
      "additionalProperties": false
    },
    "sort": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "field",
          "direction"
        ],
        "additionalProperties": false
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "具体条目字段由该能力的 result_schema 约束；本 profile 不伪造统一领域对象。"
    },
    "has_more": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "properties": {
        "requested": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "effective": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "truncation_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "requested",
        "effective",
        "truncation_reason"
      ],
      "additionalProperties": false
    },
    "unread_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scope",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "spec_version",
    "scope",
    "snapshot",
    "snapshot_unavailable_reason",
    "consistency",
    "sort",
    "count",
    "items",
    "has_more",
    "truncated",
    "next_cursor",
    "limits",
    "unread_scopes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "snapshot": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "snapshot_unavailable_reason": {
            "type": "string",
            "minLength": 1
          },
          "consistency": {
            "properties": {
              "mode": {
                "enum": [
                  "live",
                  "best_effort"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "snapshot_unavailable_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consistency": {
            "properties": {
              "mode": {
                "const": "snapshot"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/snapshot"
          },
          "consistency": {
            "properties": {
              "drift_policy": {
                "const": "reject"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consistency": {
            "properties": {
              "mode": {
                "enum": [
                  "live",
                  "best_effort"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "consistency": {
            "properties": {
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "has_more": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "next_cursor": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "has_more": {
            "const": true
          },
          "truncated": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "next_cursor": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "truncated": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "limits": {
            "properties": {
              "truncation_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "limits": {
            "properties": {
              "truncation_reason": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "unread_scopes": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "truncated": {
            "const": true
          }
        }
      }
    }
  ]
}
