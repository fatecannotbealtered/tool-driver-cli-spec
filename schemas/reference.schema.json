{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:reference:1.0",
  "title": "reference",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "tool_version": {
      "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/semver"
    },
    "spec_version": {
      "allOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/semver"
        },
        {
          "pattern": "^1\\."
        }
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "effects": {
            "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/effects"
          },
          "modes": {
            "type": "array",
            "items": {
              "enum": [
                "session",
                "file",
                "device"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "request_schema": {
            "type": "string",
            "minLength": 1
          },
          "result_schema": {
            "type": "string",
            "minLength": 1
          },
          "maturity": {
            "enum": [
              "draft",
              "experimental",
              "verified",
              "stable"
            ]
          },
          "environments": {
            "type": "array",
            "items": {
              "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/environment"
            },
            "minItems": 1
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recovery": {
            "type": "object",
            "properties": {
              "atomicity": {
                "enum": [
                  "none",
                  "per_item",
                  "whole",
                  "unknown"
                ]
              },
              "undo": {
                "type": "boolean"
              },
              "idempotent": {
                "type": "boolean"
              },
              "cancel": {
                "type": "boolean"
              }
            },
            "required": [
              "atomicity",
              "undo",
              "idempotent",
              "cancel"
            ],
            "additionalProperties": false
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "extensions": {
            "type": "object"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "observe",
                "plan",
                "apply",
                "submit",
                "status",
                "result",
                "verify"
              ]
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "enum": [
                    "option",
                    "positional",
                    "json"
                  ]
                },
                "binding": {
                  "type": "string",
                  "pattern": "^(?:/(?:[^~]|~[01])*)*$"
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "location",
                "binding",
                "required",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "phase": {
                  "enum": [
                    "observe",
                    "plan",
                    "apply",
                    "submit",
                    "status",
                    "result",
                    "verify"
                  ]
                },
                "request": {
                  "type": "object"
                }
              },
              "required": [
                "argv",
                "description",
                "phase",
                "request"
              ],
              "additionalProperties": false
            }
          },
          "error_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E_[A-Z0-9_]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "contains": {
              "const": "core"
            },
            "items": {
              "enum": [
                "core",
                "operation_status",
                "workflow",
                "query_page"
              ]
            }
          }
        },
        "required": [
          "id",
          "command",
          "effects",
          "modes",
          "request_schema",
          "result_schema",
          "maturity",
          "environments",
          "limits",
          "recovery",
          "evidence_refs",
          "description",
          "phases",
          "parameters",
          "examples",
          "error_codes",
          "profiles"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "extensions": {
      "type": "object"
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1
      }
    },
    "error_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^E_[A-Z0-9_]+$"
          },
          "exit_code": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "exit_code",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tool",
    "tool_version",
    "spec_version",
    "schema_version",
    "capabilities",
    "schemas",
    "error_codes"
  ],
  "additionalProperties": false
}
