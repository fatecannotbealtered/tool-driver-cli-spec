{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:common:1.0",
  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "session",
            "file",
            "device"
          ]
        },
        "engine_id": {
          "type": "string",
          "minLength": 1
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "mode",
        "engine_id",
        "instance_id",
        "object_id",
        "locator"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "session",
                  "device"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "instance_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "live",
            "disk",
            "mixed",
            "device",
            "trial"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "identity",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "source_details": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "source",
        "revision",
        "observed_at",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "items": {
        "enum": [
          "observe",
          "session",
          "artifact",
          "change",
          "persist",
          "deliver",
          "configure",
          "physical"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "incomplete",
            "not_applicable"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "enum": [
            "none",
            "partial",
            "complete"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "not_run",
                  "passed",
                  "failed",
                  "incomplete",
                  "not_applicable"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "extensions": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "status",
              "required"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "passed",
                        "failed"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "evidence_ref"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "not_applicable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ]
          }
        },
        "not_checked": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "required",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "scope",
        "snapshot_id",
        "coverage",
        "checks",
        "not_checked",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "passed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "snapshot_id": {
                "type": "string",
                "minLength": 1
              },
              "coverage": {
                "enum": [
                  "complete"
                ]
              },
              "checks": {
                "minItems": 1
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "execution": {
          "enum": [
            "not_started",
            "running",
            "completed",
            "failed",
            "interrupted",
            "unknown"
          ]
        },
        "change": {
          "enum": [
            "not_applied",
            "applied",
            "partial",
            "rolled_back",
            "unknown"
          ]
        },
        "persistence": {
          "enum": [
            "not_applicable",
            "unchanged",
            "unsaved",
            "saved",
            "partial",
            "unknown"
          ]
        },
        "verification": {
          "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/verification"
        }
      },
      "required": [
        "execution",
        "change",
        "persistence",
        "verification"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^E_[A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "application": {
          "type": "string",
          "minLength": 1
        },
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "session",
            "file",
            "device"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "application",
        "application_version",
        "platform",
        "arch",
        "adapter_version",
        "mode",
        "limitations"
      ],
      "additionalProperties": false
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
