{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:workflow:1.0",
  "title": "workflow",
  "description": "可选组合结果 profile。只描述步骤关系与实际结果，不定义执行脚本、原子事务或自动重放。",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "spec_version": {
      "allOf": [
        {
          "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/semver"
        },
        {
          "pattern": "^1\\."
        }
      ]
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "independent_batch",
        "dependent_workflow"
      ]
    },
    "failure_policy": {
      "enum": [
        "stop",
        "continue_independent"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "operation_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "status": {
            "enum": [
              "not_started",
              "running",
              "completed",
              "failed",
              "skipped",
              "cancelled",
              "unknown"
            ]
          },
          "receipt": {
            "anyOf": [
              {
                "$ref": "urn:tool-driver-cli-spec:receipt:1.0"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "skip_reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "error": {
            "anyOf": [
              {
                "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/error"
              },
              {
                "type": "null"
              }
            ]
          },
          "checkpoint_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "extensions": {
            "type": "object"
          },
          "phase": {
            "enum": [
              "observe",
              "plan",
              "apply",
              "submit",
              "status",
              "result",
              "verify"
            ]
          },
          "effects": {
            "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/effects"
          }
        },
        "required": [
          "id",
          "depends_on",
          "operation_id",
          "status",
          "receipt",
          "output_refs",
          "skip_reason",
          "error",
          "phase",
          "effects"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "skipped"
                }
              }
            },
            "then": {
              "properties": {
                "skip_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "not_started",
                    "running",
                    "completed",
                    "failed",
                    "cancelled",
                    "unknown"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "skip_reason": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "properties": {
                    "receipt": {
                      "$ref": "urn:tool-driver-cli-spec:receipt:1.0"
                    }
                  }
                },
                {
                  "properties": {
                    "output_refs": {
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "receipt": {
                  "$ref": "urn:tool-driver-cli-spec:receipt:1.0"
                }
              }
            },
            "then": {
              "properties": {
                "operation_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "properties": {
                    "error": {
                      "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/error"
                    }
                  }
                },
                {
                  "properties": {
                    "receipt": {
                      "$ref": "urn:tool-driver-cli-spec:receipt:1.0"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "not_started": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "not_started",
        "running",
        "completed",
        "failed",
        "skipped",
        "cancelled",
        "unknown"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "spec_version",
    "operation_id",
    "observed_at",
    "kind",
    "failure_policy",
    "steps",
    "summary"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "independent_batch"
          }
        }
      },
      "then": {
        "properties": {
          "steps": {
            "items": {
              "properties": {
                "depends_on": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      }
    }
  ]
}
