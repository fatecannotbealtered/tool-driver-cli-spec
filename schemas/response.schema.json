{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tool-driver-cli-spec:response:1.0",
  "title": "response",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "observe",
        "plan",
        "apply",
        "submit",
        "status",
        "result",
        "verify"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "receipt": {
          "$ref": "urn:tool-driver-cli-spec:receipt:1.0"
        },
        "plan": {
          "$ref": "urn:tool-driver-cli-spec:plan:1.0"
        },
        "operation_status": {
          "$ref": "urn:tool-driver-cli-spec:operation-status:1.0"
        },
        "workflow": {
          "$ref": "urn:tool-driver-cli-spec:workflow:1.0"
        },
        "query_page": {
          "$ref": "urn:tool-driver-cli-spec:query-page:1.0"
        }
      },
      "additionalProperties": true
    },
    "error": {
      "$ref": "urn:tool-driver-cli-spec:common:1.0#/$defs/error"
    },
    "meta": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "ok",
    "schema_version",
    "request_id",
    "phase",
    "meta"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "phase": {
            "enum": [
              "apply",
              "result"
            ]
          }
        },
        "required": [
          "ok",
          "phase"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "anyOf": [
              {
                "required": [
                  "receipt"
                ]
              },
              {
                "required": [
                  "workflow"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "phase": {
            "enum": [
              "submit",
              "status"
            ]
          }
        },
        "required": [
          "ok",
          "phase"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "operation_status"
            ]
          }
        }
      }
    }
  ]
}
