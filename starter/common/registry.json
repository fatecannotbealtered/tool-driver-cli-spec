{
  "registry_version": "2.0",
  "name": "{{NAME}}",
  "product_version": "{{VERSION}}",
  "description": "{{NAME}} drives a {{PROFILE}}-mode target for AI agents. The native adapter is not implemented yet.",
  "risk_tier": "T1",
  "changelog": "CHANGELOG.md",
  "record": {
    "store": "SQLite file in the tool state directory",
    "retain_days": 30,
    "survives_cli_exit": true,
    "survives_reconnect": true,
    "survives_instance_restart": true,
    "limitations": ["A synchronous apply whose CLI process ends reports unknown once its lease expires."]
  },
  "builtins": {
    "maturity": "experimental",
    "evidence_refs": []
  },
  "schemas": {
    "target_view": {
      "shape": "object",
      "fields": ["target", "snapshot", "properties"],
      "untrusted_fields": ["properties"]
    },
    "receipt": {
      "shape": "object",
      "fields": ["receipt", "preview", "confirm_token", "expires_at"],
      "untrusted_fields": ["receipt.changed_items"],
      "json_schema": {
        "$ref": "urn:tool-driver-cli-spec:receipt:2.0"
      }
    }
  },
  "commands": [
    {
      "path": "target inspect",
      "type": "read",
      "description": "Observe one explicitly named target and its revision without changing it.",
      "params": [
        {"name": "target-id", "type": "string", "required": true, "multiple": false, "description": "the target to observe; never chosen by window focus"}
      ],
      "output_schema": "target_view",
      "examples": ["{{NAME}} target inspect --target-id <target-id> --compact"],
      "driver": {
        "capability_id": "target-inspect",
        "effects": ["observe"],
        "phases": ["observe"],
        "modes": ["{{PROFILE}}"],
        "maturity": "draft",
        "environments": [
          {"application": "native application (not configured)", "application_version": "unconfigured", "platform": "any", "arch": "any",
           "adapter_version": "{{VERSION}}", "mode": "{{PROFILE}}", "limitations": ["Declaration only; the adapter refuses every native call."]}
        ],
        "limits": ["The starter adapter refuses this command with E_UNSUPPORTED."],
        "recovery": {"atomicity": "none", "undo": false, "idempotent": true, "cancel": false},
        "profiles": ["core"],
        "error_codes": ["E_USAGE", "E_VALIDATION", "E_NOT_FOUND", "E_UNSUPPORTED", "E_BACKEND_UNAVAILABLE", "E_HUMAN_REQUIRED"],
        "evidence_refs": []
      }
    },
    {
      "path": "target apply",
      "type": "write",
      "description": "Apply one declared change to an explicitly named target, then read it back.",
      "params": [
        {"name": "target-id", "type": "string", "required": true, "multiple": false, "description": "the target to change"},
        {"name": "change", "type": "json", "required": true, "multiple": false, "description": "the change, as JSON (inline, @file or - for stdin)"}
      ],
      "output_schema": "receipt",
      "examples": [
        "{{NAME}} target apply --target-id <target-id> --change @change.json --dry-run",
        "{{NAME}} target apply --target-id <target-id> --change @change.json --confirm <confirm_token>"
      ],
      "driver": {
        "capability_id": "target-apply",
        "effects": ["change"],
        "phases": ["plan", "apply"],
        "modes": ["{{PROFILE}}"],
        "maturity": "draft",
        "environments": [
          {"application": "native application (not configured)", "application_version": "unconfigured", "platform": "any", "arch": "any",
           "adapter_version": "{{VERSION}}", "mode": "{{PROFILE}}", "limitations": ["Declaration only; the adapter refuses every native call."]}
        ],
        "limits": ["The starter adapter refuses this command with E_UNSUPPORTED."],
        "recovery": {"atomicity": "unknown", "undo": false, "idempotent": false, "cancel": false},
        "profiles": ["core"],
        "error_codes": ["E_USAGE", "E_VALIDATION", "E_FORBIDDEN", "E_CONFIRMATION_REQUIRED", "E_CONFLICT", "E_UNSUPPORTED", "E_BUSY",
                        "E_BACKEND_UNAVAILABLE", "E_NATIVE_FAILURE", "E_PARTIAL", "E_OUTCOME_UNKNOWN", "E_VERIFY_FAILED",
                        "E_VERIFY_INCOMPLETE", "E_HUMAN_REQUIRED"],
        "evidence_refs": []
      }
    }
  ]
}
