{
  "registry_version": "1.0",
  "name": "{{NAME}}",
  "product_version": "{{VERSION}}",
  "entrypoint": "{{NAME}}",
  "description": "Draft native-driver seed with explicit unsupported adapter boundaries.",
  "error_codes": [
    {
      "code": "E_VALIDATION",
      "exit_code": 2,
      "description": "Invalid input; no native call was made."
    },
    {
      "code": "E_UNSUPPORTED",
      "exit_code": 3,
      "description": "The native adapter is not implemented."
    },
    {
      "code": "E_OUTCOME_UNKNOWN",
      "exit_code": 4,
      "description": "The backend result is unknown; do not blindly resend."
    },
    {
      "code": "E_CONFIG",
      "exit_code": 5,
      "description": "Missing or invalid configuration."
    },
    {
      "code": "E_INTEGRITY",
      "exit_code": 6,
      "description": "Managed vendor data has drifted."
    },
    {
      "code": "E_IO",
      "exit_code": 1,
      "description": "Input or output I/O failed."
    },
    {
      "code": "E_NATIVE_FAILURE",
      "exit_code": 7,
      "description": "Native execution failed."
    },
    {
      "code": "E_BACKEND_UNAVAILABLE",
      "exit_code": 3,
      "description": "Native backend is unavailable."
    },
    {
      "code": "E_INTERNAL",
      "exit_code": 1,
      "description": "A protocol component failed."
    }
  ],
