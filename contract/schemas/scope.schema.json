{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fatecannotbealtered/tool-driver-cli-spec/contract/schemas/scope.schema.json",
  "title": "Authorization scope file",
  "description": "Written by a person, or by an Agent as DSEC-011 allows; read by the tool (DSEC-010 to DSEC-016). A target is a target key prefix; the target `untitled:` covers new documents.",
  "type": "object",
  "required": ["scope_id", "effects", "dangerous", "targets", "expires_at"],
  "additionalProperties": false,
  "properties": {
    "scope_id": {"type": "string", "minLength": 1},
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["lifecycle", "change", "artifact", "persist", "configure", "deliver", "physical"]}
    },
    "dangerous": {"type": "boolean"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(file:///|untitled:|device:)"}
    },
    "expires_at": {"$ref": "error.schema.json#/$defs/utc"},
    "confirm": {"const": "always"}
  }
}
