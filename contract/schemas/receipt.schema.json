{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fatecannotbealtered/tool-driver-cli-spec/contract/schemas/receipt.schema.json",
  "title": "Write result",
  "description": "The data of a completed write (DCLI-061) and the receipt it carries. Commands with no target object (session open, doc create and the like) have no target.",
  "type": "object",
  "required": ["operation_id", "receipt", "result"],
  "additionalProperties": false,
  "properties": {
    "operation_id": {"$ref": "preview.schema.json#/$defs/operation_id"},
    "receipt": {"$ref": "#/$defs/receipt"},
    "result": true
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "required": ["execution", "change", "delivery", "persistence", "verification"],
      "additionalProperties": false,
      "properties": {
        "execution": {"enum": ["not_started", "running", "completed", "failed", "interrupted", "unknown"]},
        "change": {"enum": ["not_applicable", "not_applied", "applied", "partial", "rolled_back", "unknown"]},
        "delivery": {"enum": ["not_applicable", "not_attempted", "delivered", "partial", "rejected", "unknown"]},
        "persistence": {"enum": ["not_applicable", "unchanged", "saved", "partial", "unknown"]},
        "verification": {"enum": ["not_applicable", "not_run", "passed", "failed", "incomplete"]}
      },
      "if": {
        "anyOf": [
          {"properties": {"change": {"const": "applied"}}},
          {"properties": {"persistence": {"const": "saved"}}},
          {"properties": {"delivery": {"const": "delivered"}}}
        ]
      },
      "then": {"properties": {"verification": {"not": {"const": "not_applicable"}}}}
    },
    "receipt": {
      "type": "object",
      "required": ["operation_id", "command", "effects", "tier", "outcome", "observed", "mismatched"],
      "properties": {
        "operation_id": {"$ref": "preview.schema.json#/$defs/operation_id"},
        "command": {"type": "string", "minLength": 1},
        "target": {"$ref": "preview.schema.json#/$defs/target"},
        "effects": {"type": "array", "minItems": 1, "items": {"$ref": "preview.schema.json#/$defs/effect"}},
        "tier": {"$ref": "preview.schema.json#/$defs/tier"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "observed": {
          "description": "The values read back, one object per key: a target key, a produced file under its file key with path, bytes and sha256, or for a command with no target object the object's name, such as session.",
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "mismatched": {
          "description": "The fields that do not match, each written <field>@<key>, where <key> is its key in observed.",
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*@.+$"}
        },
        "session": {"$ref": "preview.schema.json#/$defs/session_ref"},
        "document": {"$ref": "preview.schema.json#/$defs/document_ref"},
        "failed_stage": {"enum": ["apply", "deliver", "persist", "verify"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [{"$ref": "#/$defs/receipt_optional"}],
      "unevaluatedProperties": false
    },
    "receipt_optional": {
      "description": "Optional receipt keys outside the fixed list: simulated is true when the result came from a simulated device (DSEC-062).",
      "properties": {
        "simulated": {"const": true}
      }
    }
  }
}
