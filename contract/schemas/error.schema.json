{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fatecannotbealtered/tool-driver-cli-spec/contract/schemas/error.schema.json",
  "title": "Error object",
  "description": "The error member of a failure envelope (DCLI-010 to DCLI-013).",
  "type": "object",
  "required": ["code", "message", "retryable", "details"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": ["E_USAGE", "E_VALIDATION", "E_AMBIGUOUS", "E_UNSUPPORTED", "E_NOT_FOUND", "E_AUTH", "E_FORBIDDEN", "E_CONFIG", "E_BACKEND_UNAVAILABLE", "E_CONFIRMATION_REQUIRED", "E_CONFLICT", "E_NETWORK", "E_BUSY", "E_TIMEOUT", "E_OUTCOME_UNKNOWN", "E_HUMAN_REQUIRED", "E_PARTIAL", "E_VERIFY_FAILED", "E_VERIFY_INCOMPLETE", "E_NATIVE_FAILURE", "E_PROTOCOL", "E_INTEGRITY", "E_IO", "E_INTERRUPTED", "E_UNKNOWN"]
    },
    "message": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"},
    "details": {"$ref": "#/$defs/details"}
  },
  "allOf": [
    {
      "if": {"properties": {"code": {"enum": ["E_NETWORK", "E_BUSY", "E_TIMEOUT", "E_INTERRUPTED"]}}},
      "then": {"properties": {"retryable": {"const": true}}},
      "else": {"properties": {"retryable": {"const": false}}}
    },
    {"if": {"properties": {"code": {"const": "E_USAGE"}}}, "then": {"properties": {"details": {"required": ["problem"]}}}},
    {"if": {"properties": {"code": {"const": "E_AMBIGUOUS"}}}, "then": {"properties": {"details": {"required": ["candidates"]}}}},
    {"if": {"properties": {"code": {"const": "E_FORBIDDEN"}}}, "then": {"properties": {"details": {"required": ["scope"]}}}},
    {"if": {"properties": {"code": {"const": "E_CONFIRMATION_REQUIRED"}}}, "then": {"properties": {"details": {"required": ["preview", "confirm_token", "expires_at"]}}}},
    {"if": {"properties": {"code": {"const": "E_CONFLICT"}}}, "then": {"properties": {"details": {"required": ["conflict"]}}}},
    {"if": {"properties": {"code": {"const": "E_OUTCOME_UNKNOWN"}}}, "then": {"properties": {"details": {"required": ["lookup"], "properties": {"dispatch_state": {"const": "unknown"}}}}}},
    {"if": {"properties": {"code": {"const": "E_BUSY"}}}, "then": {"properties": {"details": {"required": ["retry_after_ms"], "properties": {"dispatch_state": {"const": "not_started"}}}}}},
    {"if": {"properties": {"code": {"const": "E_HUMAN_REQUIRED"}}}, "then": {"properties": {"details": {"required": ["action", "resume"]}}}},
    {
      "if": {"properties": {"code": {"const": "E_PARTIAL"}}},
      "then": {"properties": {"details": {"oneOf": [{"required": ["receipt"]}, {"required": ["batch"]}, {"required": ["update"]}]}}}
    },
    {
      "if": {"properties": {"code": {"enum": ["E_VERIFY_FAILED", "E_VERIFY_INCOMPLETE"]}}},
      "then": {"properties": {"details": {"oneOf": [{"required": ["receipt"]}, {"required": ["batch"]}]}}}
    }
  ],
  "$defs": {
    "details": {
      "type": "object",
      "required": ["dispatch_state", "next_action"],
      "properties": {
        "dispatch_state": {"enum": ["not_started", "dispatched", "unknown"]},
        "next_action": {"type": "string", "minLength": 1},
        "problem": {"type": "string"},
        "parameter": {"type": "string"},
        "candidates": {"type": "array", "minItems": 2},
        "conflict": {
          "enum": ["token_invalid", "token_expired", "token_used", "token_mismatch", "scope_changed", "target_locked", "session_changed", "document_changed", "plugin_changed", "blocked", "file_changed_on_disk", "file_missing", "unsaved_changes", "file_open_in_session"]
        },
        "scope": {"$ref": "#/$defs/scope_refusal"},
        "lookup": {"type": "string", "minLength": 1},
        "retry_after_ms": {"type": "integer", "minimum": 0},
        "action": {"enum": ["dismiss_dialog", "activate_license", "sign_in", "install_component", "confirm_on_device", "restart_application", "other"]},
        "resume": {"type": "string", "minLength": 1},
        "preview": {"$ref": "preview.schema.json#/$defs/preview"},
        "confirm_token": {"type": "string", "minLength": 1},
        "expires_at": {"$ref": "#/$defs/utc"},
        "receipt": {"$ref": "receipt.schema.json#/$defs/receipt"},
        "batch": {"$ref": "batch.schema.json"},
        "update": {"$ref": "update.schema.json"},
        "native_message": {"type": "string"},
        "knowledge": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}}
      },
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"}
    },
    "scope_refusal": {
      "description": "What the scope lacks for this command (E_FORBIDDEN), and a scope fragment the person can paste into the scope file.",
      "type": "object",
      "required": ["missing", "snippet"],
      "additionalProperties": false,
      "properties": {
        "missing": {
          "type": "object",
          "required": ["effects", "targets", "dangerous"],
          "additionalProperties": false,
          "properties": {
            "effects": {"type": "array", "uniqueItems": true, "items": {"$ref": "scope.schema.json#/properties/effects/items"}},
            "targets": {"type": "array", "uniqueItems": true, "items": {"$ref": "scope.schema.json#/properties/targets/items"}},
            "dangerous": {"type": "boolean"}
          },
          "anyOf": [
            {"properties": {"effects": {"minItems": 1}}},
            {"properties": {"targets": {"minItems": 1}}},
            {"properties": {"dangerous": {"const": true}}}
          ]
        },
        "snippet": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "effects": {"$ref": "scope.schema.json#/properties/effects"},
            "targets": {"$ref": "scope.schema.json#/properties/targets"},
            "dangerous": {"$ref": "scope.schema.json#/properties/dangerous"}
          }
        }
      }
    },
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"}
  }
}
