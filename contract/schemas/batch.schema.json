{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fatecannotbealtered/tool-driver-cli-spec/contract/schemas/batch.schema.json",
  "title": "Batch result",
  "description": "Per-object results of a command run with --ids (DCLI-064).",
  "type": "object",
  "required": ["items", "summary"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target", "ok"],
        "additionalProperties": false,
        "properties": {
          "target": {"$ref": "preview.schema.json#/$defs/target"},
          "operation_id": {"$ref": "preview.schema.json#/$defs/operation_id"},
          "ok": {"type": "boolean"},
          "receipt": {"$ref": "receipt.schema.json#/$defs/receipt"},
          "error": {"$ref": "error.schema.json"},
          "skipped": {"type": "boolean"}
        },
        "if": {"properties": {"ok": {"const": true}}},
        "then": {"required": ["receipt"]},
        "else": {"anyOf": [{"required": ["error"]}, {"required": ["skipped"]}]}
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "succeeded", "failed", "unknown", "skipped"],
      "additionalProperties": false,
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    }
  }
}
