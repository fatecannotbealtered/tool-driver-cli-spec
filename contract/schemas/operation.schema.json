{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fatecannotbealtered/tool-driver-cli-spec/contract/schemas/operation.schema.json",
  "title": "Operation record",
  "description": "One record in the state directory, returned by operation get (DCLI-035, DCLI-059). Commands with no target object have no target; a batch record names all its targets, and each of its items is a child record whose `batch` is the batch's operation ID.",
  "type": "object",
  "required": ["operation_id", "command", "effects", "tier", "scope_id", "state", "planned_at"],
  "additionalProperties": false,
  "properties": {
    "operation_id": {"$ref": "preview.schema.json#/$defs/operation_id"},
    "command": {"type": "string", "minLength": 1},
    "target": {"$ref": "preview.schema.json#/$defs/targets"},
    "batch": {"$ref": "preview.schema.json#/$defs/operation_id"},
    "effects": {"type": "array", "minItems": 1, "items": {"$ref": "preview.schema.json#/$defs/effect"}},
    "tier": {"$ref": "preview.schema.json#/$defs/tier"},
    "scope_id": {"type": "string"},
    "state": {"enum": ["planned", "dispatched", "completed", "failed", "unknown"]},
    "preview": {"$ref": "preview.schema.json#/$defs/preview"},
    "receipt": {"$ref": "receipt.schema.json#/$defs/receipt"},
    "planned_at": {"$ref": "error.schema.json#/$defs/utc"},
    "dispatched_at": {"$ref": "error.schema.json#/$defs/utc"},
    "finished_at": {"$ref": "error.schema.json#/$defs/utc"},
    "resolution": {
      "description": "How an outcome-unknown operation was resolved: by reading the target back (read_back, with the observed values) or, only when read-back is impossible, by the Agent with evidence.",
      "type": "object",
      "required": ["outcome", "resolved_by", "resolved_at"],
      "additionalProperties": false,
      "properties": {
        "outcome": {"enum": ["applied", "not_applied", "partial"]},
        "resolved_by": {"enum": ["read_back", "agent"]},
        "observed": {"type": "object"},
        "evidence": {"type": "string", "minLength": 1},
        "resolved_at": {"$ref": "error.schema.json#/$defs/utc"}
      },
      "if": {"properties": {"resolved_by": {"const": "agent"}}},
      "then": {"required": ["evidence"]},
      "else": {"required": ["observed"], "not": {"required": ["evidence"]}}
    }
  }
}
