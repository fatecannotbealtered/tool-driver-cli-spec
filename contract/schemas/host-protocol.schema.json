{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fatecannotbealtered/tool-driver-cli-spec/contract/schemas/host-protocol.schema.json",
  "title": "Host protocol",
  "description": "Discovery files and JSON-RPC 2.0 messages between the CLI and a host component (DCLI-270 to DCLI-281). The fake host's own address (DVER-023) uses the same framing and also answers the CLI-side capabilities, which this schema leaves out because a host component never receives them. Each message is framed by a Content-Length header. Every message is a request from the CLI or the reply to it; there are no notifications. A method's params are the adapter request of the same capability plus deadline_ms, and its result is the adapter result (adapter.schema.json).",
  "anyOf": [
    {"$ref": "#/$defs/discovery_file"},
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/result_response"},
    {"$ref": "#/$defs/error_response"}
  ],
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "rpc_id": {"type": ["integer", "string"]},
    "application": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
    },
    "discovery_file": {
      "type": "object",
      "required": ["address", "pid", "application", "protocol_version", "plugin_version", "started_at"],
      "additionalProperties": false,
      "properties": {
        "address": {"type": "string", "pattern": "^(\\\\\\\\\\.\\\\pipe\\\\|/)"},
        "pid": {"type": "integer", "minimum": 1},
        "application": {"$ref": "#/$defs/application"},
        "protocol_version": {"$ref": "#/$defs/semver"},
        "plugin_version": {"type": "string"},
        "started_at": {"$ref": "error.schema.json#/$defs/utc"}
      }
    },
    "method": {
      "enum": ["hello", "close_session", "documents", "create_doc", "open_doc", "save_doc", "save_doc_as", "close_doc", "undo", "read", "preview", "apply", "read_back", "job_status", "cancel"]
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/rpc_id"},
        "method": {"$ref": "#/$defs/method"},
        "params": {
          "type": "object",
          "required": ["deadline_ms"],
          "properties": {"deadline_ms": {"type": "integer", "minimum": 1}}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "hello"}}},
          "then": {"properties": {"params": {"required": ["protocol_version", "cli_version"], "additionalProperties": false, "properties": {"deadline_ms": true, "protocol_version": {"$ref": "#/$defs/semver"}, "cli_version": {"type": "string"}}}}}
        },
        {"if": {"properties": {"method": {"const": "close_session"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/close_session"}}}},
        {"if": {"properties": {"method": {"const": "documents"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/documents"}}}},
        {"if": {"properties": {"method": {"const": "create_doc"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/create_doc"}}}},
        {"if": {"properties": {"method": {"const": "open_doc"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/open_doc"}}}},
        {"if": {"properties": {"method": {"const": "save_doc"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/save_doc"}}}},
        {"if": {"properties": {"method": {"const": "save_doc_as"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/save_doc_as"}}}},
        {"if": {"properties": {"method": {"const": "close_doc"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/close_doc"}}}},
        {"if": {"properties": {"method": {"const": "undo"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/undo"}}}},
        {"if": {"properties": {"method": {"const": "read"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/read"}}}},
        {"if": {"properties": {"method": {"const": "preview"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/preview"}}}},
        {"if": {"properties": {"method": {"const": "apply"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/apply"}}}},
        {"if": {"properties": {"method": {"const": "read_back"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/read_back"}}}},
        {"if": {"properties": {"method": {"const": "job_status"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/job_status"}}}},
        {"if": {"properties": {"method": {"const": "cancel"}}}, "then": {"properties": {"params": {"$ref": "adapter.schema.json#/$defs/requests/properties/cancel"}}}}
      ]
    },
    "hello_result": {
      "type": "object",
      "required": ["protocol_version", "plugin_version", "application", "session", "methods"],
      "additionalProperties": false,
      "properties": {
        "protocol_version": {"$ref": "#/$defs/semver"},
        "plugin_version": {"type": "string"},
        "application": {"$ref": "#/$defs/application"},
        "session": {"$ref": "preview.schema.json#/$defs/session_ref"},
        "methods": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/method"}}
      }
    },
    "result_response": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/rpc_id"},
        "result": {
          "anyOf": [
            {"$ref": "#/$defs/hello_result"},
            {
              "type": "object",
              "properties": {"dispatch_state": {"enum": ["not_started", "dispatched", "unknown"]}}
            }
          ]
        }
      }
    },
    "error_response": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"$ref": "#/$defs/rpc_id"},
        "error": {
          "type": "object",
          "required": ["code", "message", "data"],
          "additionalProperties": false,
          "properties": {
            "code": {"const": -32000},
            "message": {"type": "string"},
            "data": {
              "type": "object",
              "required": ["code", "dispatch_state"],
              "additionalProperties": false,
              "properties": {
                "code": {"enum": ["E_BUSY", "E_NATIVE_FAILURE", "E_HUMAN_REQUIRED", "E_NOT_FOUND", "E_VALIDATION", "E_UNSUPPORTED"]},
                "dispatch_state": {"enum": ["not_started", "dispatched", "unknown"]},
                "native_message": {"type": "string"},
                "retry_after_ms": {"type": "integer", "minimum": 0},
                "action": {"$ref": "error.schema.json#/$defs/details/properties/action"},
                "knowledge": {"$ref": "error.schema.json#/$defs/details/properties/knowledge"}
              },
              "allOf": [
                {"if": {"properties": {"code": {"const": "E_BUSY"}}}, "then": {"required": ["retry_after_ms"], "properties": {"dispatch_state": {"const": "not_started"}}}},
                {"if": {"properties": {"code": {"const": "E_HUMAN_REQUIRED"}}}, "then": {"required": ["action"]}}
              ]
            }
          }
        }
      }
    }
  }
}
