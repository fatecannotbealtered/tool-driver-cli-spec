{
  "tool": "kicad-cli",
  "version": "1.2.0",
  "spec_version": "1.0.0",
  "driver": {
    "modes": [
      "file",
      "session"
    ],
    "application": "KiCad",
    "versions": ">=10.0 <11",
    "host_component": true
  },
  "index": [
    {
      "path": "footprint move",
      "summary": "Move footprints.",
      "effects": [
        "change"
      ],
      "tier": {
        "file": "two_step",
        "session": "direct"
      }
    },
    {
      "path": "doc save",
      "summary": "Save a document.",
      "effects": [
        "persist"
      ],
      "tier": "two_step"
    },
    {
      "path": "doc close",
      "summary": "Close a document.",
      "effects": [
        "lifecycle"
      ],
      "tier": "direct"
    }
  ]
}
