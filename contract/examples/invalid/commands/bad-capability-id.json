{
  "tool": "kicad-cli",
  "version": "1.2.0",
  "commands": [
    {
      "path": "footprint move",
      "summary": "Move one or more footprints.",
      "effects": [
        "change"
      ],
      "modes": [
        "file",
        "session"
      ],
      "target_kind": "footprint",
      "flags": [
        {
          "name": "--id",
          "type": "string",
          "summary": "Reference designator of the footprint."
        },
        {
          "name": "--x",
          "type": "quantity",
          "quantity": "length",
          "summary": "X position.",
          "coordinate_system": "board: origin at the page's top-left corner, x right, y down"
        },
        {
          "name": "--y",
          "type": "quantity",
          "quantity": "length",
          "summary": "Y position.",
          "coordinate_system": "board: origin at the page's top-left corner, x right, y down"
        }
      ],
      "untrusted_fields": [],
      "adapter_capabilities": [
        "read",
        "preview",
        "apply",
        "read_back"
      ],
      "survey_ids": [
        "preview",
        "apply"
      ],
      "irreversible": false,
      "halt": false,
      "tolerances": {
        "x_mm": 0.001,
        "y_mm": 0.001
      },
      "default_fields": [
        "id",
        "x_mm",
        "y_mm"
      ],
      "related_knowledge": [
        "move-locked-footprint"
      ]
    }
  ]
}
