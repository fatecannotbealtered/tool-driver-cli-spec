      {"id": "G10", "title": "scope changed between dry run and confirm"},
      {"id": "R01", "title": "reference, index and single command"},
      {"id": "R02", "title": "command tree rules"},
      {"id": "R03", "title": "unknown command, flag or argument"},
      {"id": "R04", "title": "every envelope is valid"},
      {"id": "R05", "title": "context, doctor and operation list on empty state"},
      {"id": "R06", "title": "every command exercised by tool tests"}
    ],
    "driver": [
      {"id": "D01", "title": "several instances without --session", "applies_when": ["session"]},
      {"id": "D02", "title": "session reconnected after dry run", "applies_when": ["session"]},
      {"id": "D03", "title": "document changed after dry run", "applies_when": ["writes"]},
      {"id": "D04", "title": "application busy", "applies_when": ["session", "device"]},
      {"id": "D05", "title": "blocking dialog", "applies_when": ["session"]},
      {"id": "D06", "title": "disconnect after dispatch", "applies_when": ["session", "device"]},
      {"id": "D07", "title": "change without read-back", "applies_when": ["writes"]},
      {"id": "D08", "title": "read-back mismatch", "applies_when": ["writes"]},
      {"id": "D09", "title": "session-mode change is not saved", "applies_when": ["session"]},
      {"id": "D10", "title": "close document with unsaved changes", "applies_when": ["session"]},
      {"id": "D11", "title": "cancel a long job", "applies_when": ["jobs"]},
      {"id": "D12", "title": "host component version mismatch", "applies_when": ["host_component"]},
      {"id": "D13", "title": "physical parameter without a unit", "applies_when": ["always"]},
      {"id": "D14", "title": "physical effect without --dangerous or scope", "applies_when": ["physical"]},
      {"id": "D15", "title": "simulated device", "applies_when": ["device"]},
      {"id": "D16", "title": "direct change in session mode", "applies_when": ["session"]},
      {"id": "D17", "title": "scope requires confirmation always", "applies_when": ["writes"]},
      {"id": "D18", "title": "human edited the document before save", "applies_when": ["session"]},
      {"id": "D19", "title": "team knowledge registration", "applies_when": ["always"]},
      {"id": "D20", "title": "host protocol major version mismatch", "applies_when": ["host_component"]},
      {"id": "D21", "title": "host heartbeat lost", "applies_when": ["host_component"]},
      {"id": "D22", "title": "one instance does not respond", "applies_when": ["session"]},
      {"id": "D23", "title": "device in emergency stop or fault", "applies_when": ["device"]}
    ]
  },
  "behavior_matrix_rows": [
    {"row": "normal", "group": "general"},
    {"row": "empty", "group": "general"},
    {"row": "invalid_input", "group": "general"},
